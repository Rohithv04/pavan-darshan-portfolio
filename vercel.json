{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/post"
    },
    {
      "source": "/admin/posts/new",
      "destination": "/admin/post-edit"
    },
    {
      "source": "/admin/posts/:id/edit",
      "destination": "/admin/post-edit"
    },
    {
      "source": "/admin/resume",
      "destination": "/admin/resume"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
